# XIVLegacy: MariaDB sized for a 1 GB VPS. install.sh copies this into the
# distribution's MariaDB config folder as zz-xivlegacy.cnf (read after the
# distribution's own files, so these values win).
#
# The whole XIVLegacy database (game data + players) is under 100 MB, so a
# small buffer pool still holds all of it in memory.

[mysqld]
# Only the servers on this machine talk to the database.
bind-address            = 127.0.0.1
skip-networking         = 0
skip-name-resolve

character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# Memory
performance_schema      = OFF
innodb_buffer_pool_size = 128M
innodb_log_buffer_size  = 8M
innodb_log_file_size    = 48M
key_buffer_size         = 8M
aria_pagecache_buffer_size = 8M
query_cache_type        = 0
query_cache_size        = 0
tmp_table_size          = 16M
max_heap_table_size     = 16M
sort_buffer_size        = 1M
join_buffer_size        = 1M
read_buffer_size        = 256K
read_rnd_buffer_size    = 256K
thread_stack            = 256K
thread_cache_size       = 8
table_open_cache        = 400
table_definition_cache  = 400
# Each server process holds a few connections; this leaves plenty of room.
max_connections         = 60

# Big game-data files are loaded in one statement each at first boot.
max_allowed_packet      = 64M

[mariadb-dump]
max_allowed_packet      = 64M
[mysqldump]
max_allowed_packet      = 64M
